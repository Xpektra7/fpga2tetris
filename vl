#!/bin/bash
# Verible lint wrapper for fpga2tetris
# Usage: vl <verilog-file>

# Get absolute path to project root
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

FILE="$1"
if [ -z "$FILE" ]; then
    echo "Usage: vl <verilog-file>"
    exit 1
fi

# If FILE is not absolute, make it relative to PROJECT_ROOT
if [[ "$FILE" != /* ]]; then
    FILE="$PROJECT_ROOT/$FILE"
fi

cd "$PROJECT_ROOT"

verible-verilog-lint \
    --file_list_path=verible.filelist \
    "$FILE"
